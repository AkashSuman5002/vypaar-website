{
  "name": "vyapar",
  "version": "1.0.17",
  "description": "Vyapar desktop application (Electron wrapper around the MERN app)",
  "main": "electron/main.js",
  "author": "Vyapar",
  "scripts": {
    "electron": "electron .",
    "build:client": "npm --prefix client run build",
    "dist": "npm run build:client && electron-builder --win",
    "publish": "npm run build:client && electron-builder --win --publish always"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.4.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.vyapar.desktop",
    "productName": "Vyapar",
    "asar": false,
    "afterPack": "build-resources/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AkashSuman5002",
        "repo": "vypaar-website",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json",
      "client/build/**/*",
      "server/**/*",
      "mongodb/**/*",
      "!**/*.pdb",
      "!**/.history/**",
      "!server/.env",
      "!server/.env.*",
      "!server/coverage/**",
      "!server/tests/**",
      "!server/whatsapp-sessions/**",
      "!server/backups/**",
      "!server/exports/**",
      "!server/uploads/**",
      "!server/*.log",
      "!server/.migration-done"
    ],
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
